{
  "name": "new-clean-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun run src/server.ts",
    "worker": "bun run src/workers/index.ts",
    "build": "bun build src/server.ts --outdir ./dist --target bun --minify",
    "start:prod": "bun run dist/server.js",
    "test": "bun test",
    "lint": "bunx @biomejs/biome check src/",
    "format": "bunx @biomejs/biome format --write src/",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen"
  },
  "dependencies": {
    "@novu/api": "^1.6.0",
    "bullmq": "^5.0.0",
    "convex": "^1.27.0",
    "fastify": "^4.24.3",
    "ioredis": "^5.3.2",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "@biomejs/biome": "^1.4.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
